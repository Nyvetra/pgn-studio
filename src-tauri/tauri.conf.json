{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PGN Studio",
  "version": "0.1.0",
  "identifier": "com.nyvetra.pgnstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PGN Studio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pgn-extract/COPYING",
      "resources/pgn-extract/SOURCE.json",
      "resources/pgn-extract/eco.pgn",
      "resources/eco-supplement/eco-supplement.pgn",
      "resources/eco-supplement/SOURCE.json",
      "resources/licenses/**/*"
    ],
    "externalBin": ["binaries/pgn-extract"]
  }
}
