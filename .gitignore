# --- Rust / Cargo --------------------------------------------------------
# src-tauri/target and src-tauri/gen/schemas are also covered by
# src-tauri/.gitignore; repeated here so `git status` is unambiguous when
# run from the repository root.
target/
**/*.rs.bk

# --- Tauri -----------------------------------------------------------------
# Never commit built sidecar binaries - only the build recipe
# (engine-src/upstream.lock, scripts/build-pgn-extract.*) is tracked.
# This also covers the metadata scripts/build-pgn-extract.* generates
# next to the binary (checksums.json, build-info-<triple>.json,
# verify-report-<triple>.json, verify-upstream-suite-<triple>.log) -
# these are regenerated fresh on every build/verify run and always
# describe the (never-committed) binary sitting next to them, so
# committing a stale copy would be actively misleading.
src-tauri/binaries/*
!src-tauri/binaries/README.md

# --- Engine build cache ------------------------------------------------
# Fetched pgn-extract/TRE sources and intermediate object files used by
# scripts/build-pgn-extract.ps1/.sh. Safe to delete at any time - a
# missing cache is simply re-cloned/rebuilt from engine-src/upstream.lock.
engine-src/.build/

# --- Environment / secrets (none exist yet - hygiene for later) --------
.env
.env.local
.env.*.local

# --- OS cruft ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Claude Code worktrees ------------------------------------------------
# Each worktree under .claude/worktrees/ is a full, separate checkout of
# this repository (its own .git, node_modules, built sidecar, etc.). It was
# previously excluded only via the main clone's local .git/info/exclude,
# which is machine-local and does not travel with the repo - so on another
# machine `git add -A` would try to commit an entire embedded checkout.
# Track this ignore rule in the repo instead. Do not broaden this to
# `.claude/` as a whole: .claude/skills/ and .claude/launch.json are
# intentionally tracked.
.claude/worktrees/
